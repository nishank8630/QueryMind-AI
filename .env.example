# QueryMind AI Environment Configuration Template
DATABASE_URL=postgresql+psycopg://postgres:your_password@localhost:5432/querymind_db
APP_ENV=development
APP_MODE=demo
MAX_QUERY_ROWS=500
QUERY_TIMEOUT_SECONDS=15
RAG_TOP_K=6

# LLM Provider Configuration
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Vector Store & Embeddings
QDRANT_URL=local
EMBEDDING_MODEL=all-MiniLM-L6-v2
QDRANT_COLLECTION=querymind_knowledge

# API & Frontend Configuration
API_HOST=127.0.0.1
API_PORT=8000
FRONTEND_PORT=8501
